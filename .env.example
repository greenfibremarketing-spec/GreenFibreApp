# Green Fibre Mobile App — Environment Variables

# -----------------------------------------------------------
# API Configuration
# -----------------------------------------------------------
# Development: Use your machine's LAN IP so physical devices can reach local backend (e.g. http://<YOUR_LOCAL_IP>:5500/api)
# Production:  Set to your live backend URL (default)
EXPO_PUBLIC_API_URL=https://api.greenfibre.org/api

# -----------------------------------------------------------
# Razorpay (OPTIONAL — Key ID comes from server response by default)
# -----------------------------------------------------------
# EXPO_PUBLIC_ prefix makes this value visible in the APK bundle.
# The Razorpay Key ID is a public key, so this is acceptable ONLY for the Key ID.
# NEVER put RAZORPAY_KEY_SECRET here with the EXPO_PUBLIC_ prefix.
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# -----------------------------------------------------------
# NOTE: This file (.env) is in .gitignore and is NEVER committed.
# Teammates should copy this file to .env and fill in local values.
# Production values should be set as EAS secrets:
#   eas secret:create --scope project --name EXPO_PUBLIC_API_URL --value "https://api.greenfibre.org/api"
# -----------------------------------------------------------
