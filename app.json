{
  "expo": {
    "name": "Green Fibre",
    "slug": "green-fibre-app",
    "owner": "greenfibre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#123524"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.greenfibre.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15803d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "org.greenfibre.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123524",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "212b0dd8-0219-4ae5-b00c-da538119e21f"
      }
    }
  }
}
